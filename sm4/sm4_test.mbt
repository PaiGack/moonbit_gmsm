/// SM4 public API tests (blackbox).

///|
/// Helper to convert hex string to bytes.
fn hex_to_bytes_unchecked(s : String) -> Bytes {
  let len = s.length()
  if len % 2 != 0 {
    abort("hex string must have even length")
  }
  let n = len / 2
  Bytes::makei(n, fn(i) {
    let hi = hex_nibble(s[i * 2])
    let lo = hex_nibble(s[i * 2 + 1])
    ((hi << 4) | lo).to_byte()
  })
}

///|
fn hex_nibble(c : UInt16) -> Int32 {
  if c >= 48 && c <= 57 {
    (c - 48).to_int()
  } else if c >= 65 && c <= 70 {
    (c - 65).to_int() + 10
  } else if c >= 97 && c <= 102 {
    (c - 97).to_int() + 10
  } else {
    abort("invalid hex char")
  }
}

///|
/// GM/T 0002-2012 Appendix A: standard test vector
let kat_key : Bytes = hex_to_bytes_unchecked("0123456789ABCDEFFEDCBA9876543210")

///|
let kat_plain : Bytes = hex_to_bytes_unchecked(
  "0123456789ABCDEFFEDCBA9876543210",
)
// Known ciphertext from GM/T 0002-2012 Appendix A

///|
let kat_cipher : Bytes = hex_to_bytes_unchecked(
  "681EDF34D206965E86B3E94F536E4246",
)

///|
/// Single block encryption KAT from GM/T 0002-2012 Appendix A.
test "sm4_encrypt_block_kat" {
  let cipher = @sm4.sm4_encrypt_block(kat_key, kat_plain)
  for i in 0..<16 {
    assert_eq(cipher[i], kat_cipher[i])
  }
}

///|
/// Single block decryption KAT.
test "sm4_decrypt_block_kat" {
  let plain = @sm4.sm4_decrypt_block(kat_key, kat_cipher)
  for i in 0..<16 {
    assert_eq(plain[i], kat_plain[i])
  }
}

///|
/// Single block encrypt/decrypt round-trip with random data.
test "sm4_block_roundtrip" {
  let key = hex_to_bytes_unchecked("0123456789ABCDEFFEDCBA9876543210")
  // Test 100 random blocks
  for seed in 0..<100 {
    let data = Bytes::makei(16, fn(i) {
      let v = (seed * 256 + i * 17 + 42) & 0xFF
      v.to_byte()
    })
    let cipher = @sm4.sm4_encrypt_block(key, data)
    let plain = @sm4.sm4_decrypt_block(key, cipher)
    for i in 0..<16 {
      assert_eq(plain[i], data[i])
    }
  }
}

///|
/// ECB encrypt/decrypt round-trip.
test "sm4_ecb_roundtrip" {
  let key = hex_to_bytes_unchecked("0123456789ABCDEFFEDCBA9876543210")
  let data = Bytes::makei(32, fn(i) { (i & 0xFF).to_byte() })
  let cipher = @sm4.sm4_encrypt_ecb(key, data)
  let plain = @sm4.sm4_decrypt_ecb(key, cipher)
  for i in 0..<32 {
    assert_eq(plain[i], data[i])
  }
}

///|
/// ECB encrypt/decrypt round-trip with multiple blocks.
test "sm4_ecb_roundtrip_multiple_blocks" {
  let key = hex_to_bytes_unchecked("0123456789ABCDEFFEDCBA9876543210")
  let data = Bytes::makei(48, fn(i) { ((i * 7 + 13) & 0xFF).to_byte() })
  let cipher = @sm4.sm4_encrypt_ecb(key, data)
  let plain = @sm4.sm4_decrypt_ecb(key, cipher)
  for i in 0..<48 {
    assert_eq(plain[i], data[i])
  }
}

///|
/// CBC encrypt/decrypt round-trip.
test "sm4_cbc_roundtrip" {
  let key = hex_to_bytes_unchecked("0123456789ABCDEFFEDCBA9876543210")
  let iv = hex_to_bytes_unchecked("00000000000000000000000000000000")
  let data = Bytes::makei(32, fn(i) { ((i + 1) & 0xFF).to_byte() })
  let cipher = @sm4.sm4_encrypt_cbc(key, iv, data)
  let plain = @sm4.sm4_decrypt_cbc(key, iv, cipher)
  for i in 0..<32 {
    assert_eq(plain[i], data[i])
  }
}

///|
/// CBC encrypt/decrypt round-trip with multi-block data.
test "sm4_cbc_roundtrip_multiple_blocks" {
  let key = hex_to_bytes_unchecked("0123456789ABCDEFFEDCBA9876543210")
  let iv = hex_to_bytes_unchecked("00000000000000000000000000000000")
  let data = Bytes::makei(48, fn(i) { ((i * 3 + 7) & 0xFF).to_byte() })
  let cipher = @sm4.sm4_encrypt_cbc(key, iv, data)
  let plain = @sm4.sm4_decrypt_cbc(key, iv, cipher)
  for i in 0..<48 {
    assert_eq(plain[i], data[i])
  }
}

///|
/// CBC round-trip with single block and different key/IV.
test "sm4_cbc_roundtrip_single_block" {
  let key = hex_to_bytes_unchecked("FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF")
  let iv = hex_to_bytes_unchecked("ABCDEF0123456789ABCDEF0123456789")
  let data = hex_to_bytes_unchecked("0123456789ABCDEFFEDCBA9876543210")
  let cipher = @sm4.sm4_encrypt_cbc(key, iv, data)
  let plain = @sm4.sm4_decrypt_cbc(key, iv, cipher)
  for i in 0..<16 {
    assert_eq(plain[i], data[i])
  }
}

///|
fn assert_bytes_eq(a : Bytes, b : Bytes) -> Unit {
  if a.length() != b.length() {
    abort("assert_bytes_eq: length mismatch")
  }
  for i in 0..<a.length() {
    if a[i] != b[i] {
      abort("assert_bytes_eq: byte mismatch")
    }
  }
}

///|
/// CFB known-answer tests (vectors generated by tjfoc/gmsm's SM4 primitive).
test "sm4_cfb_kat" {
  let key = hex_to_bytes_unchecked("31323334353637383930616263646566")
  let iv = hex_to_bytes_unchecked("00000000000000000000000000000000")
  let cases = [
    ("0123456789abcdeffedcba9876543210", "f1b816e7d7cf2c742eee113392c536fe"),
    (
      "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dc", "f39142984142ccafeb70e2fbb3cf61826fe170bd485dde0a99cc51f04b6e7e86",
    ),
    (
      "0b10151a1f24292e33383d42474c51565b60656a6f74797e83888d92979ca1a6abb0b5babfc4c9ced3d8dde2e7ecf1f6",
      "fb8b469a4140c8b5e30a96e9a3dd55b87be15983ee37541641623738b14fbfecbb158b6072eee057c19c01a4393b3bd2",
    ),
  ]
  for i in 0..<3 {
    let pt = hex_to_bytes_unchecked(cases[i].0)
    let ct = hex_to_bytes_unchecked(cases[i].1)
    assert_bytes_eq(@sm4.sm4_encrypt_cfb(key, iv, pt), ct)
    assert_bytes_eq(@sm4.sm4_decrypt_cfb(key, iv, ct), pt)
  }
}

///|
/// OFB known-answer tests (vectors generated by tjfoc/gmsm's SM4 primitive).
test "sm4_ofb_kat" {
  let key = hex_to_bytes_unchecked("31323334353637383930616263646566")
  let iv = hex_to_bytes_unchecked("00000000000000000000000000000000")
  let cases = [
    ("0123456789abcdeffedcba9876543210", "f1b816e7d7cf2c742eee113392c536fe"),
    (
      "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dc", "f39142984142ccafeb70e2fbb3cf6182a64f149e4ad06586fc965bb0adf1c189",
    ),
    (
      "0b10151a1f24292e33383d42474c51565b60656a6f74797e83888d92979ca1a6abb0b5babfc4c9ced3d8dde2e7ecf1f6",
      "fb8b469a4140c8b5e30a96e9a3dd55b88e55f07caa32815cd4ac6fe2fda3b5f31f546ead309c61ed636c147f8b1048c7",
    ),
  ]
  for i in 0..<3 {
    let pt = hex_to_bytes_unchecked(cases[i].0)
    let ct = hex_to_bytes_unchecked(cases[i].1)
    assert_bytes_eq(@sm4.sm4_encrypt_ofb(key, iv, pt), ct)
    assert_bytes_eq(@sm4.sm4_decrypt_ofb(key, iv, ct), pt)
  }
}

///|
/// CFB round-trip with random (block-aligned) data.
test "sm4_cfb_roundtrip" {
  let key = hex_to_bytes_unchecked("0123456789ABCDEFFEDCBA9876543210")
  let iv = hex_to_bytes_unchecked("00000000000000000000000000000000")
  for len = 16; len <= 64; len = len + 16 {
    let data = Bytes::makei(len, fn(i) { ((i * 11 + 3) & 0xFF).to_byte() })
    let dec = @sm4.sm4_decrypt_cfb(key, iv, @sm4.sm4_encrypt_cfb(key, iv, data))
    assert_bytes_eq(dec, data)
  }
}

///|
/// OFB round-trip with random (block-aligned) data.
test "sm4_ofb_roundtrip" {
  let key = hex_to_bytes_unchecked("0123456789ABCDEFFEDCBA9876543210")
  let iv = hex_to_bytes_unchecked("00000000000000000000000000000000")
  for len = 16; len <= 64; len = len + 16 {
    let data = Bytes::makei(len, fn(i) { ((i * 13 + 7) & 0xFF).to_byte() })
    let dec = @sm4.sm4_decrypt_ofb(key, iv, @sm4.sm4_encrypt_ofb(key, iv, data))
    assert_bytes_eq(dec, data)
  }
}

///|
/// GCM known-answer tests, standard (NIST SP 800-38D) behaviour.
/// Reference vectors produced with OpenSSL's / Go's `crypto/cipher` SM4-GCM
/// (cross-checked against Node's `sm4-gcm`): `sm4_gcm_encrypt` must match any
/// standard implementation.
test "sm4_gcm_kat" {
  let key = hex_to_bytes_unchecked("31323334353637383930616263646566")
  let iv = hex_to_bytes_unchecked("00000000000000000000000000000000")
  let cases = [
    (
      "0123456789abcdeffedcba9876543210", "", "db081f9dd9e855c2b3c3b17c85351d74",
      "5282c6c79fd2921b8308441a4db14e96",
    ),
    (
      "0123456789abcdeffedcba9876543210", "0123456789ab", "db081f9dd9e855c2b3c3b17c85351d74",
      "8a2a463d509790d01d70afc238c62dcd",
    ),
    (
      "0123456789abcdeffedcba9876543210", "0123456789abcdeffedcba9876543210", "db081f9dd9e855c2b3c3b17c85351d74",
      "a0e37b17bad5f0d3e38b95c9cf26dfa9",
    ),
    (
      "070a0d101316191c1f2225282b2e3134373a3d40", "", "dd2157ea43558131523d2eccd84f1e50183f4350",
      "ce40d03266bf372657589833bfd10b71",
    ),
    (
      "070a0d101316191c1f2225282b2e3134373a3d40", "0123456789ab", "dd2157ea43558131523d2eccd84f1e50183f4350",
      "90f3a9e2cc85b979fd895b3c99c37590",
    ),
    (
      "070a0d101316191c1f2225282b2e3134373a3d40", "0123456789abcdeffedcba9876543210",
      "dd2157ea43558131523d2eccd84f1e50183f4350", "c7c7cc7a817c6b3a4ac518a019c33904",
    ),
    (
      "010c17222d38434e59646f7a85909ba6b1bcc7d2dde8f3fe09141f2a35404b56", "", "db274dd87d7bdb63147b649e76f1b4c29eb9b9c2db0448b5fc6fa5c6e54c5dbf",
      "3b324b277e9eef07580a8f4a68d75511",
    ),
    (
      "010c17222d38434e59646f7a85909ba6b1bcc7d2dde8f3fe09141f2a35404b56", "0123456789ab",
      "db274dd87d7bdb63147b649e76f1b4c29eb9b9c2db0448b5fc6fa5c6e54c5dbf", "658132f7d4a46158f2db4c454ec52bf0",
    ),
    (
      "010c17222d38434e59646f7a85909ba6b1bcc7d2dde8f3fe09141f2a35404b56", "0123456789abcdeffedcba9876543210",
      "db274dd87d7bdb63147b649e76f1b4c29eb9b9c2db0448b5fc6fa5c6e54c5dbf", "32b5576f995db31b45970fd9cec56764",
    ),
    // 空明文
    ("", "", "", "c671ad7b2484fbdd65d40660b24da5e2"),
  ]
  for i in 0..<cases.length() {
    let pt = hex_to_bytes_unchecked(cases[i].0)
    let aad = if cases[i].1 == "" {
      Bytes::makei(0, fn(_) { b'\x00' })
    } else {
      hex_to_bytes_unchecked(cases[i].1)
    }
    let ct = hex_to_bytes_unchecked(cases[i].2)
    let tag = hex_to_bytes_unchecked(cases[i].3)
    let (c, t) = @sm4.sm4_gcm_encrypt(key, iv, pt, aad)
    assert_bytes_eq(c, ct)
    assert_bytes_eq(t, tag)
    assert_bytes_eq(@sm4.sm4_gcm_decrypt(key, iv, ct, aad, tag), pt)
  }
}

///|
/// 标准 96 位 nonce 路径（`J0 = IV ‖ 00000001`）的独立向量。
test "sm4_gcm_kat_96bit_iv" {
  let key = hex_to_bytes_unchecked("0123456789abcdeffedcba9876543210")
  let iv = hex_to_bytes_unchecked("000102030405060708090a0b")
  let pt = hex_to_bytes_unchecked("0123456789abcdef")
  let (ct, tag) = @sm4.sm4_gcm_encrypt(key, iv, pt, b"")
  assert_eq(@byteutil.bytes_to_hex(ct), "54025df6381a64f0")
  assert_eq(@byteutil.bytes_to_hex(tag), "a11c2194efba58e3789823cddddee2f1")
  assert_bytes_eq(@sm4.sm4_gcm_decrypt(key, iv, ct, b"", tag), pt)
}

///|
/// `sm4_gcm_encrypt_legacy` / `sm4_gcm_decrypt_legacy` 保持 tjfoc/gmsm 的
/// 非标准输出（GHASH 长度块用字节长度、计数器进位被吞）。这些向量由
/// tjfoc/gmsm `sm4.Sm4GCM` 生成，与上面的标准向量**不同**，这正是两者需要
/// 分开的原因。
test "sm4_gcm_kat_legacy_gmsm" {
  let key = hex_to_bytes_unchecked("31323334353637383930616263646566")
  let iv = hex_to_bytes_unchecked("00000000000000000000000000000000")
  let cases = [
    (
      "0123456789abcdeffedcba9876543210", "", "8c53b32074c928cad16ee621a3b8aeba",
      "f6858619fde0889a7fb886aec5a1b79d",
    ),
    (
      "070a0d101316191c1f2225282b2e3134373a3d40", "0123456789ab", "8a7afb57ee74fc3930907991fec2ad9ed7a1a5a1",
      "58f08931ca9f6884dab04824337388cc",
    ),
  ]
  for i in 0..<cases.length() {
    let pt = hex_to_bytes_unchecked(cases[i].0)
    let aad = if cases[i].1 == "" {
      Bytes::makei(0, fn(_) { b'\x00' })
    } else {
      hex_to_bytes_unchecked(cases[i].1)
    }
    let ct = hex_to_bytes_unchecked(cases[i].2)
    let tag = hex_to_bytes_unchecked(cases[i].3)
    let (c, t) = @sm4.sm4_gcm_encrypt_legacy(key, iv, pt, aad)
    assert_bytes_eq(c, ct)
    assert_bytes_eq(t, tag)
    assert_bytes_eq(@sm4.sm4_gcm_decrypt_legacy(key, iv, ct, aad, tag), pt)
  }
  // 两个变体对同一输入给出不同结果：legacy 的 tag 是按其自身（非标准）
  // GHASH 计算出来的，标准入口不会接受它，所以两套向量必须分开。
  let aad = hex_to_bytes_unchecked(cases[1].1)
  let legacy_tag = hex_to_bytes_unchecked(cases[1].3)
  let legacy_ct = hex_to_bytes_unchecked(cases[1].2)
  let rejected = try {
    let _ = @sm4.sm4_gcm_decrypt(key, iv, legacy_ct, aad, legacy_tag)
    false
  } catch {
    @sm4.InvalidTag => true
    _ => false
  }
  assert_true(rejected)
}

///|
/// GCM round-trip for various lengths (including empty and non-block-aligned)
/// and AAD lengths.
test "sm4_gcm_roundtrip" {
  let key = hex_to_bytes_unchecked("0123456789ABCDEFFEDCBA9876543210")
  let iv = hex_to_bytes_unchecked("00000000000000000000000000000000")
  for len in 0..<48 {
    let pt = Bytes::makei(len, fn(i) {
      ((i * 7 + len * 3 + 5) & 0xFF).to_byte()
    })
    let aad = Bytes::makei(len % 13, fn(i) { ((i * 5 + 1) & 0xFF).to_byte() })
    let (c, t) = @sm4.sm4_gcm_encrypt(key, iv, pt, aad)
    assert_eq(c.length(), len)
    assert_bytes_eq(@sm4.sm4_gcm_decrypt(key, iv, c, aad, t), pt)
    // a wrong tag is rejected instead of returning plaintext
    let bad_tag = Bytes::makei(16, fn(i) { if i == 0 { 0xFF } else { t[i] } })
    let r : Result[Bytes, @sm4.SM4Error] = Ok(
      @sm4.sm4_gcm_decrypt(key, iv, c, aad, bad_tag),
    ) catch {
      e => Err(e)
    }
    assert_true(r is Err(@sm4.SM4Error::InvalidTag))
  }
}

///|
/// CFB rejects a key that is not 16 bytes.
test "sm4_cfb_invalid_key" {
  let iv = hex_to_bytes_unchecked("00000000000000000000000000000000")
  let bad_key = hex_to_bytes_unchecked("00")
  let pt = hex_to_bytes_unchecked("00000000000000000000000000000000")
  let r : Result[Bytes, @sm4.SM4Error] = Ok(
    @sm4.sm4_encrypt_cfb(bad_key, iv, pt),
  ) catch {
    e => Err(e)
  }
  match r {
    Ok(_) => abort("cfb: expected InvalidKey")
    Err(e) => assert_true(e is @sm4.SM4Error::InvalidKey)
  }
}

///|
/// CFB rejects an IV that is not 16 bytes.
test "sm4_cfb_invalid_iv" {
  let key = hex_to_bytes_unchecked("0123456789ABCDEFFEDCBA9876543210")
  let bad_iv = hex_to_bytes_unchecked("00")
  let pt = hex_to_bytes_unchecked("00000000000000000000000000000000")
  let r : Result[Bytes, @sm4.SM4Error] = Ok(
    @sm4.sm4_encrypt_cfb(key, bad_iv, pt),
  ) catch {
    e => Err(e)
  }
  match r {
    Ok(_) => abort("cfb: expected InvalidIV")
    Err(e) => assert_true(e is @sm4.SM4Error::InvalidIV)
  }
}

///|
/// CFB rejects plaintext that is not a multiple of the block size.
test "sm4_cfb_invalid_data" {
  let key = hex_to_bytes_unchecked("0123456789ABCDEFFEDCBA9876543210")
  let iv = hex_to_bytes_unchecked("00000000000000000000000000000000")
  let not_aligned = hex_to_bytes_unchecked("0000")
  let r : Result[Bytes, @sm4.SM4Error] = Ok(
    @sm4.sm4_encrypt_cfb(key, iv, not_aligned),
  ) catch {
    e => Err(e)
  }
  match r {
    Ok(_) => abort("cfb: expected InvalidData")
    Err(e) => assert_true(e is @sm4.SM4Error::InvalidData)
  }
}

///|
/// GCM rejects a key that is not 16 bytes.
test "sm4_gcm_invalid_key" {
  let iv = hex_to_bytes_unchecked("00000000000000000000000000000000")
  let bad_key = hex_to_bytes_unchecked("00")
  let r : Result[(Bytes, Bytes), @sm4.SM4Error] = Ok(
    @sm4.sm4_gcm_encrypt(bad_key, iv, b"hello", b""),
  ) catch {
    e => Err(e)
  }
  match r {
    Ok(_) => abort("gcm: expected InvalidKey")
    Err(e) => assert_true(e is @sm4.SM4Error::InvalidKey)
  }
}
