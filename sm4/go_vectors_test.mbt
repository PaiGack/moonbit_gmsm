  let plain = go_hex_to_bytes("070a0d101316191c1f2225282b2e3134373a3d404346494c4f5255585b5e6164676a6d707376797c7f8285888b8e9194")
  let cipher = @sm4.sm4_encrypt_cbc(key, iv, plain)
